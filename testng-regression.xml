<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The regression run: the whole suite. Every test is handed the 'regression' group by
     TestSetupTransformer, so the include below picks up all of them, and any test added later joins
     the regression run without touching this file. Run before a release or nightly. -->
<suite name="Regression">
    <test name="Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="io.maxbet.tests"/>
        </packages>
    </test>
</suite>
